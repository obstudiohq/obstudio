{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "noErrorTruncation": false,
    "allowJs": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@obstudio/react": ["./packages/react/src"],
      "@obstudio/react/*": ["./packages/react/src/*"],
      "@obstudio/utils/*": ["./packages/utils/src/*"],
      "docs/*": ["./docs/*"]
    }
  },
  "exclude": [
    "**/.*/",
    "**/build",
    "**/build-tests",
    "**/build-typecheck",
    "**/node_modules",
    "docs/export"
  ]
}
